# ─── SUPABASE ─────────────────────────────────────────────────────────────────
# Project Settings > API no Supabase Dashboard
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=                    # alias da service_role_key usada pelo @supabase/server
SUPABASE_PUBLISHABLE_KEY=               # publishable key do dashboard
SUPABASE_JWKS_URL=                      # ex: https://<ref>.supabase.co/auth/v1/.well-known/jwks.json

# Prefixo VITE_ para o frontend React
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── AUTH / JWT ────────────────────────────────────────────────────────────────
# Chave secreta para assinar JWTs (HS256). Gerar com: openssl rand -base64 32
JWT_SECRET=
# Fallback VITE_ para o frontend (usado apenas no build)
VITE_JWT_SECRET=

# ─── CLOUDFLARE R2 (Armazenamento com Egress Grátis) ─────────────────────────
# Opcional. Se preenchido com STORAGE_PROVIDER=r2, o sistema envia os áudios
# e comprovativos para o R2 da Cloudflare com tráfego 100% grátis.
# Se desativado ou ausente, usa automaticamente o Supabase Storage existente.
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=seubeat-media
R2_PUBLIC_DOMAIN=

# ─── OPENAI (Geração de Letras) ────────────────────────────────────────────────
# Obter em: platform.openai.com/account/api-keys
OPENAI_API_KEY=
# Modelo e timeout
OPENAI_TIMEOUT_MS=30000

# ─── GEMINI (Geração de Letras) ────────────────────────────────────────────────
# Obter em: makersuite.google.com/app/apikey
GEMINI_API_KEY=

# ─── ANTHROPIC CLAUDE (Geração de Letras) ─────────────────────────────────────
# Obter em: console.anthropic.com/account/keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_TIMEOUT_MS=15000

# ─── DEEPSEEK (Geração de Letras) ─────────────────────────────────────────────
# Obter em: platform.deepseek.com (pré-pago; modelo mais barato dos 4 providers)
DEEPSEEK_API_KEY=
# Alias opcional se o provedor/deploy usar este nome. Preferir DEEPSEEK_API_KEY.
DEEPSEEK_SECRET_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=30000
# Estimativa média por letra para custos/rentabilidade (USD).
DEEPSEEK_COST_PER_GENERATION_USD=0.0005

# ─── IA — Ordem dos providers (fallback) ───────────────────────────────────────
# Ordem em que os providers de geração de letras são tentados.
# Valores: deepseek, openai, gemini, claude (CSV, sem espaços).
# Por omissão o código usa: deepseek,gemini,openai,claude
AI_PROVIDER_ORDER=deepseek,gemini,openai,claude

# Retry por provedor: tentativas para erros transitórios (503/high demand) vs
# erros fatais (429/quota/config). Backoff exponencial com jitter entre tentativas.
AI_MAX_ATTEMPTS=2                 # tentativas máximas para erros não-transitórios
AI_TRANSIENT_MAX_ATTEMPTS=4       # tentativas máximas para erros transitórios (503/429/high demand)
AI_RETRY_BASE_DELAY_MS=1000       # atraso inicial do backoff (dobra a cada tentativa)
AI_RETRY_MAX_BACKOFF_MS=8000      # teto do backoff
AI_TIMEOUT_MS=120000              # timeout global por provedor

# Cooldown entre alertas de email ao admin quando TODOS os providers falham (ms).
ADMIN_ALERT_COOLDOWN_MS=900000

# ─── SUNO API (Geração de Música + Clonagem de Voz) ──────────────────────────
# Obter em: sunoapi.org/api-key
SUNO_API_KEY=
# Fallback VITE_ para o frontend (usado apenas no build)
VITE_SUNO_API_KEY=
SUNO_TIMEOUT_MS=45000
# Custo estimado por crédito Suno (USD) — usado para cálculo de rentabilidade
SUNO_COST_PER_CREDIT_USD=0.005
# Custo fixo mensal operacional (USD) — usado para relatórios de margem
MONTHLY_FIXED_COST_USD=0
# Sotaque angolano no canto (adiciona instrução de accent quando a letra é PT).
# Desativar apenas se o Suno responder mal à instrução: SUNO_ACCENT_ENABLED=false
SUNO_ACCENT_ENABLED=true

# ─── BREVO REST API (Envio de Emails) ─────────────────────────────────────────
# Chave REST API (xkeysib-...) — obter em: brevo.com > Settings > SMTP & API > API Keys
# NOTA: SMTP (portas 587/465) não funciona no Render; usar REST API.
BREVO_API_KEY=
EMAIL_FROM=josuemiguelsued@gmail.com
EMAIL_FROM_NAME=SeuBeat

# ─── AMBIENTE ─────────────────────────────────────────────────────────────────
# URL pública (localhost para desenvolvimento, URL real em produção)
APP_URL="https://seubeat.onrender.com"
NODE_ENV=development

# Domínio permitido no CORS
# DEV: * (permite todos)
# PROD: domínio exato, ex: https://seubeat.ao ou https://www.seubeat.ao
# Se vazio em produção, bloqueia todos os origins (seguro por defeito)
ALLOWED_ORIGIN=*
# Timeout para download de áudio (ms)
DOWNLOAD_TIMEOUT_MS=120000
# Activar logs detalhados (1 para activar)
DEBUG=0

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  AVISO DE SEGURANÇA                                                       ║
# ║  NUNCA cometer .env no repositório.                                       ║
# ║  Em produção (Render): usar "Environment Variables" no dashboard.          ║
# ║  Senhas e tokens sensíveis devem ir para "Secret Files" ou env secrets.    ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ─── META PIXEL & CAPI (FACEBOOK ADS) ───────────────────────────────────────────
# Obter em: business.facebook.com > Events Manager > Pixel
# (mesmo ID, mas VITE_ prefixo para expor ao browser)
VITE_META_PIXEL_ID=
META_PIXEL_ID=
# Token da API de Conversões: Events Manager > API de Conversões > Criar token
META_ACCESS_TOKEN=
# Conta de anúncios para puxar gasto real via Ads Insights (ex: act_123 ou 123).
# O token precisa de permissão ads_read/read_insights.
META_AD_ACCOUNT_ID=
META_GRAPH_API_VERSION=v21.0
# Se a conta Meta estiver noutra moeda, converter gasto para USD neste fator.
META_AD_SPEND_USD_RATE=1
# Taxa usada para comparar receita Kz com custos USD e para enviar valores à Meta (CAPI Purchase/InitiateCheckout/AddPaymentInfo/SubmitApplication) em USD.
USD_TO_KZ_RATE=1200

# ─── GOOGLE ANALYTICS 4 (GA4) ─────────────────────────────────────────────────
# Measurement ID do fluxo de dados web (ex: G-XXXXXXXXXX). Deixar vazio para
# desactivar — os eventos gtag (pageview, begin_checkout, purchase) só são
# enviados quando este ID está preenchido.
VITE_GA_MEASUREMENT_ID=

# ─── PAGAMENTOS MULTICAIXA ────────────────────────────────────────────────────
# Dados do pagamento por referência (Entidade + Referência) mostrados no wizard.
# O número de telemóvel para transferências Multicaixa Express (default: mesmo da referência).
MULTICAIXA_ENTIDADE=10116
MULTICAIXA_REFERENCIA=929423278
MULTICAIXA_EXPRESS_PHONE=929423278

# ─── WHATSAPP ──────────────────────────────────────────────────────────────────
# Número de WhatsApp para suporte (código do país incluído)
VITE_WHATSAPP_NUMBER=244922058136

# WhatsApp Business Cloud API (Meta) — substitui o antigo envio via Baileys/QR.
# Obter em: business.facebook.com > WhatsApp Manager > API Setup (System User token)
# Deixar vazio para desactivar o envio automático de mensagens WhatsApp.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Número associado à WABA (usado no painel para mostrar "API configurada · <nº>")
WHATSAPP_PHONE=244922058136
# Token de verificação do webhook (Meta App > WhatsApp > Configuration > Verify token)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Versão da Graph API (default v21.0)
WHATSAPP_GRAPH_API_VERSION=v21.0

# Verificação do número WhatsApp na Meta (request_code / verify_code).
# Sem `code_verification_status: VERIFIED`, a Cloud API bloqueia envios para
# clientes reais (#100 Invalid parameter). Usa o painel admin (tab Abandonados >
# "Verificar número") para pedir o código e confirmá-lo — chega ao telemóvel dono
# do chip. Método de envio do código (SMS | VOICE) — default SMS.
WHATSAPP_VERIFY_METHOD=SMS

# Buckets que enviam por WhatsApp (separados por vírgula). Restantes vão só por email.
# Default: 30min. Deixar vazio = todos os buckets por WhatsApp.
WHATSAPP_ENABLED_BUCKETS=30min

# Constraints da campanha de Abandonados
WHATSAPP_DAILY_CAP=30
WHATSAPP_START_HOUR=9
WHATSAPP_END_HOUR=20
WHATSAPP_MIN_SEND_DELAY_MS=3000
WHATSAPP_MAX_SEND_DELAY_MS=8000

# Templates de ciclo de vida (entrega + feedback) — devem existir na Meta Business Manager
# Nota: os templates de abandono (30min/24h/48h/72h) estão em whatsappTemplates.ts
WHATSAPP_DELIVERY_TEMPLATE=seubeat_entrega_v1
WHATSAPP_FEEDBACK_TEMPLATE=seubeat_feedback_v1

# ─── SENTRY (MONITORIZAÇÃO DE ERROS) ──────────────────────────────────────────
# Obter em: sentry.io > Settings > Projects > Create Project
# Deixar vazio para desactivar
SENTRY_DSN=
VITE_SENTRY_DSN=
# Para source maps: sentry.io > Settings > Auth Tokens > Create
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─── JINA AI (Embeddings para opencode-mem) ───────────────────────────────────
# Obter em: jina.ai (gratuito: 1M tokens/mês)
# Usado pelo plugin opencode-mem para memória semântica entre sessões
JINA_API_KEY=

# ─── ADMIN ────────────────────────────────────────────────────────────────────
# Emails dos administradores (separados por vírgula)
ADMIN_EMAIL=
# Senha do painel /admin
ADMIN_PASSWORD=
# Fallback VITE_ para o frontend (usado apenas no build)
VITE_ADMIN_PASSWORD=

# ─── FEATURE FLAGS ─────────────────────────────────────────────────────────────
# Activar teaser de letras (verso 1 + refrão editável, resto bloqueado até pagar)
# true = activado, false = letra completa grátis (comportamento original)
VITE_ENABLE_LYRICS_TEASER=false
