# ─── SUPABASE ─────────────────────────────────────────────────────────────────
# Project Settings > API no Supabase Dashboard
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=                    # alias da service_role_key usada pelo @supabase/server
SUPABASE_PUBLISHABLE_KEY=               # publishable key do dashboard
SUPABASE_JWKS_URL=                      # ex: https://<ref>.supabase.co/auth/v1/.well-known/jwks.json

# Prefixo VITE_ para o frontend React
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── ANTHROPIC CLAUDE (Geração de Letras) ─────────────────────────────────────
# Obter em: console.anthropic.com/account/keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_TIMEOUT_MS=15000
OPENAI_TIMEOUT_MS=30000

# ─── IA — Ordem dos providers (fallback) ───────────────────────────────────────
# Ordem em que os providers de geração de letras são tentados.
# Valores: openai, gemini, claude (CSV, sem espaços).
# Por omissão o código usa: gemini,openai,claude
AI_PROVIDER_ORDER=gemini,openai,claude

# Retry por provedor: tentativas para erros transitórios (503/high demand) vs
# erros fatais (429/quota/config). Backoff exponencial com jitter entre tentativas.
AI_MAX_ATTEMPTS=2                 # tentativas máximas para erros não-transitórios
AI_TRANSIENT_MAX_ATTEMPTS=4       # tentativas máximas para erros transitórios (503/429/high demand)
AI_RETRY_BASE_DELAY_MS=1000       # atraso inicial do backoff (dobra a cada tentativa)
AI_RETRY_MAX_BACKOFF_MS=8000      # teto do backoff
AI_TIMEOUT_MS=120000              # timeout global por provedor

# Cooldown entre alertas de email ao admin quando TODOS os providers falham (ms).
ADMIN_ALERT_COOLDOWN_MS=900000

# ─── SUNO API (Geração de Música + Clonagem de Voz) ──────────────────────────
# Obter em: sunoapi.org/api-key
SUNO_API_KEY=
SUNO_TIMEOUT_MS=45000

# ─── BREVO REST API (Envio de Emails) ─────────────────────────────────────────
# Chave REST API (xkeysib-...) — obter em: brevo.com > Settings > SMTP & API > API Keys
# NOTA: SMTP (portas 587/465) não funciona no Render; usar REST API.
BREVO_API_KEY=
EMAIL_FROM=josuemiguelsued@gmail.com
EMAIL_FROM_NAME=SeuBeat

# ─── AMBIENTE ─────────────────────────────────────────────────────────────────
# URL pública (localhost para desenvolvimento, URL real em produção)
APP_URL="https://seubeat.onrender.com"
NODE_ENV=development

# Domínio permitido no CORS (deixar * para desenvolvimento)
ALLOWED_ORIGIN=*
# Timeout para download de áudio (ms)
DOWNLOAD_TIMEOUT_MS=120000
# Activar logs detalhados (1 para activar)
DEBUG=0

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  AVISO DE SEGURANÇA                                                       ║
# ║  NUNCA cometer .env no repositório.                                       ║
# ║  Em produção (Render): usar "Environment Variables" no dashboard.          ║
# ║  Senhas e tokens sensíveis devem ir para "Secret Files" ou env secrets.    ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ─── META PIXEL & CAPI (FACEBOOK ADS) ───────────────────────────────────────────
# Obter em: business.facebook.com > Events Manager > Pixel
# (mesmo ID, mas VITE_ prefixo para expor ao browser)
VITE_META_PIXEL_ID=
META_PIXEL_ID=
# Token da API de Conversões: Events Manager > API de Conversões > Criar token
META_ACCESS_TOKEN=

# ─── WHATSAPP ──────────────────────────────────────────────────────────────────
# Número de WhatsApp para suporte (código do país incluído)
VITE_WHATSAPP_NUMBER=244922058136

# ─── SENTRY (MONITORIZAÇÃO DE ERROS) ──────────────────────────────────────────
# Obter em: sentry.io > Settings > Projects > Create Project
# Deixar vazio para desactivar
SENTRY_DSN=
VITE_SENTRY_DSN=
# Para source maps: sentry.io > Settings > Auth Tokens > Create
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─── ADMIN ────────────────────────────────────────────────────────────────────
# Emails dos administradores (separados por vírgula)
ADMIN_EMAIL=
# Senha do painel /admin
ADMIN_PASSWORD=

# ─── FEATURE FLAGS ─────────────────────────────────────────────────────────────
# Activar teaser de letras (verso 1 + refrão editável, resto bloqueado até pagar)
# true = activado, false = letra completa grátis (comportamento original)
VITE_ENABLE_LYRICS_TEASER=false
